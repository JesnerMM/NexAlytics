# Normaliza todos los archivos de texto a LF en el repo,
# Git convierte a CRLF al hacer checkout en Windows (autocrlf=true)
* text=auto eol=lf

# Fuerza LF para archivos de código (nunca CRLF en repo)
*.cs        text eol=lf
*.cshtml    text eol=lf
*.razor     text eol=lf
*.csproj    text eol=lf
*.sln       text eol=lf
*.json      text eol=lf
*.xml       text eol=lf
*.config    text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.sql       text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.ts        text eol=lf
*.html      text eol=lf

# Binarios — nunca tocar los line endings
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.svg       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
*.otf       binary
*.exe       binary
*.dll       binary
*.pdb       binary
*.zip       binary
*.nupkg     binary
*.snupkg    binary
