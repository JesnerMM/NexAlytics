@model List<NexAlytics.Application.DTOs.ImportJobDto>
@{
    ViewData["Title"] = "Historial de Importaciones";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-clock-history me-2"></i>Historial de Importaciones</h2>
        <span class="text-muted">@Model.Count importaciones</span>
    </div>
    <a asp-action="Index" class="btn nex-btn-primary">
        <i class="bi bi-cloud-upload me-1"></i>Nueva Importación
    </a>
</div>

<div class="nex-card">
    <div class="nex-card-body p-0">
        <table class="table nex-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Tipo</th>
                    <th>Archivo</th>
                    <th>Estado</th>
                    <th>Registros</th>
                    <th>Procesados</th>
                    <th>Errores</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var j in Model)
                {
                    <tr>
                        <td><span class="nex-id">#@j.Id</span></td>
                        <td><span class="badge bg-light text-dark">@j.Tipo</span></td>
                        <td class="text-truncate" style="max-width:180px" title="@j.ArchivoNombre">
                            <i class="bi bi-file-earmark-spreadsheet me-1"></i>@j.ArchivoNombre
                        </td>
                        <td>
                            <span class="nex-badge @(j.Estado == "Completado" ? "nex-badge-success" : j.Estado == "Pendiente" ? "nex-badge-warning" : "nex-badge-secondary")">
                                @j.Estado
                            </span>
                        </td>
                        <td>@j.Registros</td>
                        <td class="text-success">@j.RegistrosProcesados</td>
                        <td class="text-danger">@j.RegistrosError</td>
                        <td>@j.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>
                            <form asp-action="Reprocess" method="post"
                                  onsubmit="return confirm('¿Reprocesar importación #@j.Id?')">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@j.Id" />
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="Reprocesar">
                                    <i class="bi bi-arrow-repeat"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="9" class="text-center text-muted py-4">No hay importaciones registradas</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
