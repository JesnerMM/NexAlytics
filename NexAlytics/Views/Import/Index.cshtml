@{
    ViewData["Title"] = "Importación de Datos";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-cloud-upload me-2"></i>Importación de Datos</h2>
        <span class="text-muted">Cargue archivos Excel o CSV</span>
    </div>
    <a asp-action="History" class="btn btn-outline-secondary">
        <i class="bi bi-clock-history me-1"></i>Historial
    </a>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="nex-card">
            <div class="nex-card-header">
                <h5><i class="bi bi-file-earmark-arrow-up me-2"></i>Cargar Archivo</h5>
            </div>
            <div class="nex-card-body">
                <form asp-action="Upload" method="post" enctype="multipart/form-data" id="uploadForm">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-semibold">Tipo de datos</label>
                        <div class="d-flex gap-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipo" value="Clientes" id="tipoClientes" checked>
                                <label class="form-check-label" for="tipoClientes">
                                    <i class="bi bi-people me-1"></i>Clientes
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipo" value="Ventas" id="tipoVentas">
                                <label class="form-check-label" for="tipoVentas">
                                    <i class="bi bi-cart3 me-1"></i>Ventas
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="tipo" value="Productos" id="tipoProductos">
                                <label class="form-check-label" for="tipoProductos">
                                    <i class="bi bi-box-seam me-1"></i>Productos
                                </label>
                            </div>
                        </div>
                    </div>

                    <div class="nex-dropzone" id="dropzone">
                        <div class="nex-dropzone-icon"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div class="nex-dropzone-text">
                            <strong>Arrastra tu archivo aquí</strong> o haz clic para seleccionar
                        </div>
                        <div class="nex-dropzone-hint">CSV, XLSX, XLS — hasta 10MB</div>
                        <input type="file" name="file" id="fileInput" accept=".csv,.xlsx,.xls" class="nex-dropzone-input" />
                    </div>
                    <div id="fileSelected" class="mt-2 text-success d-none">
                        <i class="bi bi-file-earmark-check me-1"></i>
                        <span id="fileName"></span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn nex-btn-primary" id="uploadBtn" disabled>
                            <i class="bi bi-eye me-1"></i>Vista Previa
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="nex-card">
            <div class="nex-card-header">
                <h5><i class="bi bi-info-circle me-2"></i>Formato requerido</h5>
            </div>
            <div class="nex-card-body">
                <div id="formatClientes">
                    <h6 class="text-muted">Clientes (CSV/XLSX)</h6>
                    <code class="d-block small">Nombre, Email, Telefono</code>
                    <hr>
                    <small class="text-muted">El Email es único por empresa.</small>
                </div>
                <div id="formatVentas" class="d-none">
                    <h6 class="text-muted">Ventas (CSV/XLSX)</h6>
                    <code class="d-block small">ClienteNombre, Fecha, Total, Estado</code>
                    <hr>
                    <small class="text-muted">El cliente debe existir previamente. Fecha: yyyy-MM-dd</small>
                </div>
                <div id="formatProductos" class="d-none">
                    <h6 class="text-muted">Productos (CSV/XLSX)</h6>
                    <code class="d-block small">Nombre, Categoria, Precio</code>
                    <hr>
                    <small class="text-muted">El precio usa punto como decimal.</small>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/import.js" asp-append-version="true"></script>
}
