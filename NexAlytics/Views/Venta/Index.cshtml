@model NexAlytics.Application.DTOs.PagedResult<NexAlytics.Application.DTOs.VentaDto>
@{
    ViewData["Title"] = "Ventas";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-cart3 me-2"></i>Ventas</h2>
        <span class="text-muted">@Model.TotalCount registros</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
        </a>
        <a asp-action="Create" class="btn nex-btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva Venta</a>
    </div>
</div>

<div class="nex-card">
    <div class="nex-card-body p-0">
        <table class="table nex-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Total</th>
                    <th>Estado</th>
                    <th>Pagos</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var v in Model.Items)
                {
                    <tr>
                        <td><span class="nex-id">#@v.Id</span></td>
                        <td>@v.ClienteNombre</td>
                        <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                        <td><strong>@v.Total.ToString("C")</strong></td>
                        <td>
                            <span class="nex-badge @(v.Estado == "Completada" ? "nex-badge-success" : v.Estado == "Pendiente" ? "nex-badge-warning" : "nex-badge-secondary")">
                                @v.Estado
                            </span>
                        </td>
                        <td>
                            <a asp-controller="Pago" asp-action="Create" asp-route-ventaId="@v.Id"
                               class="btn btn-sm btn-outline-success" title="Registrar pago">
                                <i class="bi bi-plus-circle"></i>
                            </a>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@v.Id" class="btn btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@v.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@v.Id" method="post"
                                      onsubmit="return confirm('¿Eliminar venta #@v.Id?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="7" class="text-center text-muted py-4">No hay ventas registradas</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
