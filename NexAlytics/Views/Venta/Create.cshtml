@model NexAlytics.Application.DTOs.VentaDto
@{
    ViewData["Title"] = "Nueva Venta";
}

<div class="nex-page-header">
    <h2><i class="bi bi-cart-plus me-2"></i>Nueva Venta</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="nex-card">
            <div class="nex-card-body">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="ClienteId" class="form-label">Cliente</label>
                        <select asp-for="ClienteId" asp-items="ViewBag.ClienteId" class="form-select">
                            <option value="">-- Seleccionar cliente --</option>
                        </select>
                        <span asp-validation-for="ClienteId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" type="date" class="form-control"
                               value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Fecha" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Total" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Total" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Total" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Estado" class="form-label"></label>
                        <select asp-for="Estado" class="form-select">
                            <option>Pendiente</option>
                            <option>Completada</option>
                            <option>Cancelada</option>
                        </select>
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn nex-btn-primary"><i class="bi bi-check-lg me-1"></i>Guardar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
