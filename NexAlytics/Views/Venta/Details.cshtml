@model NexAlytics.Application.DTOs.VentaDto
@{
    ViewData["Title"] = $"Venta #{Model.Id}";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-receipt me-2"></i>Venta #@Model.Id</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="nex-card">
            <div class="nex-card-header"><h5>Datos de la Venta</h5></div>
            <div class="nex-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Cliente</dt>
                    <dd class="col-sm-8">@Model.ClienteNombre</dd>
                    <dt class="col-sm-4">Fecha</dt>
                    <dd class="col-sm-8">@Model.Fecha.ToString("dd/MM/yyyy")</dd>
                    <dt class="col-sm-4">Total</dt>
                    <dd class="col-sm-8"><strong>@Model.Total.ToString("C")</strong></dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        <span class="nex-badge @(Model.Estado == "Completada" ? "nex-badge-success" : Model.Estado == "Pendiente" ? "nex-badge-warning" : "nex-badge-secondary")">
                            @Model.Estado
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="nex-card">
            <div class="nex-card-header d-flex justify-content-between align-items-center">
                <h5>Pagos</h5>
                <a asp-controller="Pago" asp-action="Create" asp-route-ventaId="@Model.Id"
                   class="btn btn-sm nex-btn-primary">
                    <i class="bi bi-plus me-1"></i>Pago
                </a>
            </div>
            <div class="nex-card-body p-0">
                <table class="table nex-table mb-0">
                    <thead>
                        <tr><th>Método</th><th>Monto</th><th>Fecha</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Pagos)
                        {
                            <tr>
                                <td>@p.Metodo</td>
                                <td>@p.Monto.ToString("C")</td>
                                <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                            </tr>
                        }
                        @if (!Model.Pagos.Any())
                        {
                            <tr><td colspan="3" class="text-center text-muted py-3">Sin pagos</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
