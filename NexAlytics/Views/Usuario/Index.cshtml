@model NexAlytics.Application.DTOs.PagedResult<NexAlytics.Application.DTOs.UsuarioDto>
@{
    ViewData["Title"] = "Usuarios";
    var currentUserId = int.Parse(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "0");
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-person-gear me-2"></i>Usuarios</h2>
        <span class="text-muted">@Model.TotalCount registros</span>
    </div>
    <a asp-action="Create" class="btn nex-btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Usuario
    </a>
</div>

<div class="nex-card">
    <div class="nex-card-body p-0">
        <div class="table-responsive">
            <table class="table nex-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Rol</th>
                        <th>Fecha Creación</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Items)
                    {
                        <tr>
                            <td><span class="nex-id">#@u.Id</span></td>
                            <td><strong>@u.Nombre</strong></td>
                            <td>@u.Email</td>
                            <td>
                                @if (u.Rol == "Admin")
                                {
                                    <span class="badge nex-badge-info">Admin</span>
                                }
                                else
                                {
                                    <span class="badge nex-badge-secondary">Usuario</span>
                                }
                            </td>
                            <td>@u.FechaCreacion.ToString("dd/MM/yyyy")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-outline-info" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (u.Id != currentUserId)
                                    {
                                        <form asp-action="Delete" asp-route-id="@u.Id" method="post"
                                              onsubmit="return confirm('¿Eliminar usuario @u.Nombre?')">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay usuarios registrados</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
