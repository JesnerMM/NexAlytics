@model List<NexAlytics.Application.DTOs.ProductoDto>
@{
    ViewData["Title"] = "Productos";
    var categorias = ViewData["Categorias"] as List<string> ?? new();
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-box-seam me-2"></i>Productos</h2>
        <span class="text-muted">@Model.Count registros</span>
    </div>
    <a asp-action="Create" class="btn nex-btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Producto
    </a>
</div>

<div class="nex-card">
    <div class="nex-card-header">
        <form method="get" class="d-flex gap-2 flex-wrap">
            <select name="categoria" class="form-select" style="max-width:200px">
                <option value="">Todas las categorías</option>
                @foreach (var cat in categorias)
                {
                    <option value="@cat" selected="@(ViewData["CategoriaFiltro"]?.ToString() == cat)">@cat</option>
                }
            </select>
            <select name="activo" class="form-select" style="max-width:150px">
                <option value="">Todos</option>
                <option value="true" selected="@(ViewData["ActivoFiltro"]?.ToString() == "True")">Activos</option>
                <option value="false" selected="@(ViewData["ActivoFiltro"]?.ToString() == "False")">Inactivos</option>
            </select>
            <button type="submit" class="btn btn-outline-primary">Filtrar</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
        </form>
    </div>
    <div class="nex-card-body p-0">
        <div class="table-responsive">
        <table class="table nex-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td><span class="nex-id">#@p.Id</span></td>
                        <td><strong>@p.Nombre</strong></td>
                        <td><span class="badge bg-light text-dark">@p.Categoria</span></td>
                        <td><strong>@p.Precio.ToString("C")</strong></td>
                        <td>
                            <span class="nex-badge @(p.Activo ? "nex-badge-success" : "nex-badge-secondary")">
                                @(p.Activo ? "Activo" : "Inactivo")
                            </span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-outline-info"><i class="bi bi-eye"></i></a>
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                      onsubmit="return confirm('¿Eliminar @p.Nombre?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay productos registrados</td></tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>
