@model NexAlytics.Application.DTOs.ProductoDto
@{
    ViewData["Title"] = "Detalle Producto";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-box-seam me-2"></i>@Model.Nombre</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Editar</a>
        <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Volver</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="nex-card">
            <div class="nex-card-header"><h5>Información del Producto</h5></div>
            <div class="nex-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8"><span class="nex-id">#@Model.Id</span></dd>
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Categoría</dt>
                    <dd class="col-sm-8"><span class="badge bg-light text-dark">@Model.Categoria</span></dd>
                    <dt class="col-sm-4">Precio</dt>
                    <dd class="col-sm-8"><strong>@Model.Precio.ToString("C")</strong></dd>
                    <dt class="col-sm-4">Estado</dt>
                    <dd class="col-sm-8">
                        <span class="nex-badge @(Model.Activo ? "nex-badge-success" : "nex-badge-secondary")">
                            @(Model.Activo ? "Activo" : "Inactivo")
                        </span>
                    </dd>
                </dl>
            </div>
        </div>
    </div>
</div>
