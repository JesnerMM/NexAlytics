@model NexAlytics.Application.DTOs.ProductoDto
@{
    ViewData["Title"] = "Editar Producto";
}

<div class="nex-page-header">
    <h2><i class="bi bi-pencil me-2"></i>Editar Producto</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="nex-card">
            <div class="nex-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label"></label>
                        <input asp-for="Nombre" class="form-control" />
                        <span asp-validation-for="Nombre" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Categoria" class="form-label"></label>
                        <input asp-for="Categoria" class="form-control" />
                        <span asp-validation-for="Categoria" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Precio" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Precio" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Precio" class="text-danger small"></span>
                    </div>

                    <div class="mb-4 form-check form-switch">
                        <input asp-for="Activo" class="form-check-input" type="checkbox" />
                        <label asp-for="Activo" class="form-check-label">Activo</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn nex-btn-primary"><i class="bi bi-check-lg me-1"></i>Actualizar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
