@model NexAlytics.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}

<div class="nex-page-header">
    <h2><i class="bi bi-speedometer2 me-2"></i>Dashboard</h2>
    <span class="text-muted">Resumen ejecutivo</span>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="nex-kpi-card nex-kpi-primary">
            <div class="nex-kpi-icon"><i class="bi bi-currency-dollar"></i></div>
            <div class="nex-kpi-content">
                <div class="nex-kpi-value">@Model.VentasTotales.ToString("C")</div>
                <div class="nex-kpi-label">Ventas Totales</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="nex-kpi-card nex-kpi-success">
            <div class="nex-kpi-icon"><i class="bi bi-people"></i></div>
            <div class="nex-kpi-content">
                <div class="nex-kpi-value">@Model.ClientesActivos</div>
                <div class="nex-kpi-label">Clientes Activos</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="nex-kpi-card nex-kpi-info">
            <div class="nex-kpi-icon"><i class="bi bi-credit-card"></i></div>
            <div class="nex-kpi-content">
                <div class="nex-kpi-value">@Model.PagosRecibidos.ToString("C")</div>
                <div class="nex-kpi-label">Pagos Recibidos</div>
            </div>
        </div>
    </div>
    <div class="col-xl-3 col-md-6">
        <div class="nex-kpi-card nex-kpi-warning">
            <div class="nex-kpi-icon"><i class="bi bi-cloud-upload"></i></div>
            <div class="nex-kpi-content">
                <div class="nex-kpi-value">@Model.ImportacionesTotales</div>
                <div class="nex-kpi-label">Importaciones</div>
            </div>
        </div>
    </div>
</div>

<!-- Charts -->
<div class="row g-4 mb-4">
    <div class="col-xl-8">
        <div class="nex-card">
            <div class="nex-card-header">
                <h5><i class="bi bi-bar-chart me-2"></i>Ventas por Mes</h5>
            </div>
            <div class="nex-card-body">
                <canvas id="chartVentasMes" height="100"></canvas>
            </div>
        </div>
    </div>
    <div class="col-xl-4">
        <div class="nex-card">
            <div class="nex-card-header">
                <h5><i class="bi bi-pie-chart me-2"></i>Ventas por Estado</h5>
            </div>
            <div class="nex-card-body">
                <canvas id="chartVentasEstado" height="200"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- Latest Sales Table -->
<div class="nex-card">
    <div class="nex-card-header d-flex justify-content-between align-items-center">
        <h5><i class="bi bi-clock-history me-2"></i>Últimas Ventas</h5>
        <a asp-controller="Venta" asp-action="Index" class="btn btn-sm btn-outline-primary">Ver todas</a>
    </div>
    <div class="nex-card-body p-0">
        <div class="table-responsive">
            <table class="table nex-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Cliente</th>
                        <th>Fecha</th>
                        <th>Total</th>
                        <th>Estado</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.UltimasVentas)
                    {
                        <tr>
                            <td><span class="nex-id">#@v.Id</span></td>
                            <td>@v.ClienteNombre</td>
                            <td>@v.Fecha.ToString("dd/MM/yyyy")</td>
                            <td><strong>@v.Total.ToString("C")</strong></td>
                            <td>
                                <span class="nex-badge @(v.Estado == "Completada" ? "nex-badge-success" : v.Estado == "Pendiente" ? "nex-badge-warning" : "nex-badge-secondary")">
                                    @v.Estado
                                </span>
                            </td>
                            <td>
                                <a asp-controller="Venta" asp-action="Details" asp-route-id="@v.Id"
                                   class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.UltimasVentas.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No hay ventas registradas</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const ventasMesData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorMes));
        const ventasEstadoData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.VentasPorEstado));
    </script>
    <script src="~/js/dashboard.js" asp-append-version="true"></script>
}
