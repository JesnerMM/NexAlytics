@{
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var totalCount = (int)(ViewData["TotalCount"] ?? 0);
    var pageSize = (int)(ViewData["PageSize"] ?? 10);

    if (totalPages <= 1) return;

    // Build URL for a given page number, preserving existing query params
    string PageUrl(int p)
    {
        var existing = Context.Request.Query
            .Where(q => q.Key != "page")
            .Select(q => $"{Uri.EscapeDataString(q.Key)}={Uri.EscapeDataString(q.Value.ToString())}");
        var qs = string.Join("&", existing);
        return qs.Length > 0 ? $"?{qs}&page={p}" : $"?page={p}";
    }

    // Determine visible page range (max 5 pages centered on current)
    int rangeSize = 5;
    int start = Math.Max(1, page - rangeSize / 2);
    int end = Math.Min(totalPages, start + rangeSize - 1);
    if (end - start < rangeSize - 1) start = Math.Max(1, end - rangeSize + 1);

    var from = (page - 1) * pageSize + 1;
    var to = Math.Min(page * pageSize, totalCount);
}

<div class="nex-pagination d-flex justify-content-between align-items-center mt-3 px-3 pb-3">
    <span class="text-muted small">Mostrando @from–@to de @totalCount registros</span>

    <nav>
        <ul class="pagination pagination-sm mb-0">
            <li class="page-item @(!page.Equals(1) ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(page - 1)"><i class="bi bi-chevron-left"></i></a>
            </li>

            @if (start > 1)
            {
                <li class="page-item"><a class="page-link" href="@PageUrl(1)">1</a></li>
                @if (start > 2)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
            }

            @for (int p = start; p <= end; p++)
            {
                <li class="page-item @(p == page ? "active" : "")">
                    <a class="page-link" href="@PageUrl(p)">@p</a>
                </li>
            }

            @if (end < totalPages)
            {
                @if (end < totalPages - 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }
                <li class="page-item"><a class="page-link" href="@PageUrl(totalPages)">@totalPages</a></li>
            }

            <li class="page-item @(page < totalPages ? "" : "disabled")">
                <a class="page-link" href="@PageUrl(page + 1)"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
</div>
