@model NexAlytics.Application.DTOs.PagedResult<NexAlytics.Application.DTOs.PagoDto>
@{
    ViewData["Title"] = "Pagos";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-credit-card me-2"></i>Pagos</h2>
        <span class="text-muted">@Model.TotalCount registros</span>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i>Exportar Excel
        </a>
        <a asp-action="Create" class="btn nex-btn-primary"><i class="bi bi-plus-lg me-1"></i>Nuevo Pago</a>
    </div>
</div>

<div class="nex-card">
    <div class="nex-card-body p-0">
        <table class="table nex-table mb-0">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Venta</th>
                    <th>Método</th>
                    <th>Monto</th>
                    <th>Fecha</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model.Items)
                {
                    <tr>
                        <td><span class="nex-id">#@p.Id</span></td>
                        <td>@p.VentaInfo</td>
                        <td><span class="badge bg-light text-dark">@p.Metodo</span></td>
                        <td><strong>@p.Monto.ToString("C")</strong></td>
                        <td>@p.Fecha.ToString("dd/MM/yyyy")</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post"
                                      onsubmit="return confirm('¿Eliminar pago #@p.Id?')">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No hay pagos registrados</td></tr>
                }
            </tbody>
        </table>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
