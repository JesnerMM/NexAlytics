@model NexAlytics.Application.DTOs.PagoDto
@{
    ViewData["Title"] = "Editar Pago";
}

<div class="nex-page-header">
    <h2><i class="bi bi-pencil me-2"></i>Editar Pago #@Model.Id</h2>
</div>

<div class="row">
    <div class="col-lg-6">
        <div class="nex-card">
            <div class="nex-card-body">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input asp-for="Id" type="hidden" />
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="VentaId" class="form-label">Venta</label>
                        <select asp-for="VentaId" asp-items="ViewBag.VentaId" class="form-select"></select>
                        <span asp-validation-for="VentaId" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Metodo" class="form-label"></label>
                        <select asp-for="Metodo" class="form-select">
                            <option>Efectivo</option>
                            <option>Tarjeta</option>
                            <option>Transferencia</option>
                            <option>Cheque</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Monto" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Monto" type="number" step="0.01" class="form-control" />
                        </div>
                        <span asp-validation-for="Monto" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Fecha" class="form-label"></label>
                        <input asp-for="Fecha" type="date" class="form-control"
                               value="@Model.Fecha.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn nex-btn-primary"><i class="bi bi-check-lg me-1"></i>Actualizar</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
