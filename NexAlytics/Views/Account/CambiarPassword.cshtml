@model NexAlytics.Application.DTOs.CambiarPasswordDto
@{
    ViewData["Title"] = "Cambiar Contraseña";
}

<div class="nex-page-header">
    <h2><i class="bi bi-key me-2"></i>Cambiar Contraseña</h2>
</div>

<div class="row">
    <div class="col-lg-5">
        <div class="nex-card">
            <div class="nex-card-body">
                <form asp-action="CambiarPassword" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="All" class="alert alert-danger" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                    <div class="mb-3">
                        <label asp-for="PasswordActual" class="form-label"></label>
                        <input asp-for="PasswordActual" type="password" class="form-control" autofocus />
                        <span asp-validation-for="PasswordActual" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NuevaPassword" class="form-label"></label>
                        <input asp-for="NuevaPassword" type="password" class="form-control" />
                        <span asp-validation-for="NuevaPassword" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmarPassword" class="form-label"></label>
                        <input asp-for="ConfirmarPassword" type="password" class="form-control" />
                        <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn nex-btn-primary">
                            <i class="bi bi-check-lg me-1"></i>Actualizar contraseña
                        </button>
                        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
