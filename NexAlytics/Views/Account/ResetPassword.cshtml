@model NexAlytics.Application.DTOs.ResetPasswordDto
@{
    ViewData["Title"] = "Nueva Contraseña";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NEXAlytics — Nueva Contraseña</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/nexalytics.css" asp-append-version="true" />
</head>
<body class="nex-login-bg">
    <div class="nex-login-container">
        <div class="nex-login-card">
            <div class="nex-login-header">
                <div class="nex-login-logo">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <h1 class="nex-login-title">NEXAlytics</h1>
                <p class="nex-login-subtitle">Establecer nueva contraseña</p>
            </div>

            <div class="nex-login-card-body">
                @if (ViewData["TokenError"] != null)
                {
                    <div class="alert alert-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>@ViewData["TokenError"]
                        <div class="mt-2">
                            <a asp-controller="Account" asp-action="ForgotPassword" class="alert-link">
                                Solicitar un nuevo enlace
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <form method="post" asp-controller="Account" asp-action="ResetPassword">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="Token" />

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                {
                                    <div>@error.ErrorMessage</div>
                                }
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Nueva contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" asp-for="NuevaPassword" class="form-control" placeholder="••••••••" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Confirmar contraseña</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input type="password" asp-for="ConfirmarPassword" class="form-control" placeholder="••••••••" />
                            </div>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 nex-btn-login">
                            <i class="bi bi-check-circle me-2"></i>Establecer contraseña
                        </button>
                    </form>
                }

                <div class="text-center mt-3">
                    <a asp-controller="Account" asp-action="Login" class="text-muted small">
                        <i class="bi bi-arrow-left me-1"></i>Volver al inicio de sesión
                    </a>
                </div>
            </div>
        </div>
    </div>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
