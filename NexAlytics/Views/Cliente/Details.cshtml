@model NexAlytics.Application.DTOs.ClienteDto
@{
    ViewData["Title"] = "Detalle Cliente";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <h2><i class="bi bi-person me-2"></i>@Model.Nombre</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil me-1"></i>Editar
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Volver
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="nex-card">
            <div class="nex-card-header"><h5>Información</h5></div>
            <div class="nex-card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">ID</dt>
                    <dd class="col-sm-8"><span class="nex-id">#@Model.Id</span></dd>
                    <dt class="col-sm-4">Nombre</dt>
                    <dd class="col-sm-8">@Model.Nombre</dd>
                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>
                    <dt class="col-sm-4">Teléfono</dt>
                    <dd class="col-sm-8">@Model.Telefono</dd>
                    <dt class="col-sm-4">Registro</dt>
                    <dd class="col-sm-8">@Model.FechaRegistro.ToString("dd/MM/yyyy")</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="nex-card">
            <div class="nex-card-header"><h5>Estadísticas</h5></div>
            <div class="nex-card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="nex-stat-mini">
                            <div class="nex-stat-value">@Model.VentasCount</div>
                            <div class="nex-stat-label">Ventas</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="nex-stat-mini">
                            <div class="nex-stat-value">@Model.TotalVentas.ToString("C")</div>
                            <div class="nex-stat-label">Total Comprado</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
