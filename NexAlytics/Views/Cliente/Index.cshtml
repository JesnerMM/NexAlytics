@model NexAlytics.Application.DTOs.PagedResult<NexAlytics.Application.DTOs.ClienteDto>
@{
    ViewData["Title"] = "Clientes";
}

<div class="nex-page-header d-flex justify-content-between align-items-center">
    <div>
        <h2><i class="bi bi-people me-2"></i>Clientes</h2>
        <span class="text-muted">@Model.TotalCount registros</span>
    </div>
    <a asp-action="Create" class="btn nex-btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Nuevo Cliente
    </a>
</div>

<div class="nex-card">
    <div class="nex-card-header">
        <form method="get" class="d-flex gap-2">
            <div class="input-group" style="max-width:320px">
                <span class="input-group-text"><i class="bi bi-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Buscar por nombre o email..."
                       value="@ViewData["Search"]" />
            </div>
            <button type="submit" class="btn btn-outline-primary">Buscar</button>
            @if (ViewData["Search"] != null)
            {
                <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
            }
        </form>
    </div>
    <div class="nex-card-body p-0">
        <div class="table-responsive">
            <table class="table nex-table mb-0">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Nombre</th>
                        <th>Email</th>
                        <th>Teléfono</th>
                        <th>Registro</th>
                        <th>Ventas</th>
                        <th>Total</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Items)
                    {
                        <tr>
                            <td><span class="nex-id">#@c.Id</span></td>
                            <td><strong>@c.Nombre</strong></td>
                            <td>@c.Email</td>
                            <td>@c.Telefono</td>
                            <td>@c.FechaRegistro.ToString("dd/MM/yyyy")</td>
                            <td><span class="badge bg-secondary">@c.VentasCount</span></td>
                            <td>@c.TotalVentas.ToString("C")</td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@c.Id" class="btn btn-outline-info" title="Ver">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@c.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@c.Id" method="post"
                                          onsubmit="return confirm('¿Eliminar cliente @c.Nombre?')">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted py-4">No hay clientes registrados</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @await Html.PartialAsync("_Pagination")
</div>
