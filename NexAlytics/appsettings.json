{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=NexAnalyticsDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "PowerBI": {
    "TenantId": "<azure-tenant-id>",
    "ClientId": "<app-registration-client-id>",
    "ClientSecret": "<client-secret>",
    "WorkspaceId": "<pbi-workspace-id>",
    "ReportId": "<pbi-report-id>"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
